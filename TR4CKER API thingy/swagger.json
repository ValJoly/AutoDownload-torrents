{
  "openapi": "3.1.0",
  "info": {
    "title": "TR4CKER API bridge",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/books/free/search": {
      "get": {
        "summary": "Search Free Books",
        "description": "Search Project Gutenberg through Gutendex. Language defaults to French. Set gutenberg_only=true to disable Google Books preview fallback. Otherwise, if Gutendex times out or returns no matches and GOOGLE_BOOKS_API_KEY is configured, Google Books preview-only results may be returned. Only Gutendex EPUBs can be downloaded by the bridge. Copyright metadata reflects US status only and is not a rights determination for other countries.",
        "operationId": "search_free_books_api_books_free_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "title": "Q"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["fr", "en", "es", "de", "it", "pt"],
              "default": "fr",
              "title": "Lang"
            }
          },
          {
            "name": "gutenberg_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Gutenberg Only"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "language": {"type": "string"},
                    "results": {
                      "type": "array",
                      "items": {"type": "object", "additionalProperties": true}
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid query or unsupported language"
          },
          "502": {
            "description": "The book catalog is temporarily unavailable"
          }
        }
      }
    },
    "/api/books/free/{book_id}/download": {
      "post": {
        "summary": "Download Free Book EPUB",
        "description": "Re-fetch the Gutendex book record, verify the official EPUB URL, and save the EPUB under the configured Books folder. The bridge does not accept a client-supplied URL.",
        "operationId": "download_free_book_api_books_free__book_id__download_post",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "pattern": "^[0-9]{1,8}$"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["format"],
                "properties": {
                  "format": {"type": "string", "enum": ["epub"]}
                }
              }
            }
          }
        },
        "responses": {
          "202": {"description": "Download job accepted"},
          "422": {"description": "Invalid book ID or format"}
        }
      }
    },
    "/api/torrents": {
      "get": {
        "summary": "Search Torrents",
        "description": "Search Torrents from TR4CKER.\n\nRequired parameters:\n- cat = \"livres-audio\"\n- q = your search term",
        "operationId": "search_torrents_api_torrents_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Search query",
              "title": "Q"
            },
            "description": "Search query"
          },
          {
            "name": "cat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Category to search in",
              "default": "livres-audio",
              "title": "Cat"
            },
            "description": "Category to search in"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Search Torrents Api Torrents Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/torrents/{slug}": {
      "get": {
        "summary": "Get Torrent Details",
        "operationId": "get_torrent_details_api_torrents__slug__get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Get Torrent Details Api Torrents  Slug  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/torrents/{slug}/download": {
      "get": {
        "summary": "Download Torrent",
        "operationId": "download_torrent_api_torrents__slug__download_get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/torrents/{slug}/launch": {
      "post": {
        "summary": "Launch Torrent Download",
        "description": "Download a .torrent file, validate it with torrentool, then launch it through a configured or discovered client.\n\nOptional body parameter: `library` can be `audiobooks` (default) or `books`.\nThe chosen branch is appended to `TORRENT_DOWNLOAD_DIR`, where `AUDIOBOOKS` and `BOOKS`\npoint to the environment-relative folders such as `'\\Audiobooks'` and `'\\Books'`.",
        "operationId": "launch_torrent_download_api_torrents__slug__launch_post",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LaunchTorrentBody"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Launch Torrent Download Api Torrents  Slug  Launch Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic credentials configured via SKYFORGE_AUTH_USERNAME and SKYFORGE_AUTH_PASSWORD on the bridge server."
      }
    },
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LaunchTorrentBody": {
        "properties": {
          "library": {
            "type": "string",
            "title": "Library",
            "default": "audiobooks"
          }
        },
        "type": "object",
        "title": "LaunchTorrentBody",
        "description": "Optional launch payload. `library` defaults to `audiobooks` when omitted and chooses between the configured folder targets."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}